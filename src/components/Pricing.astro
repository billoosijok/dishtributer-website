---
const ctaLabel = 'Join early access';
---

<section class="pricing" id="pricing">
  <div class="container">
    <div class="pricing-head">
      <h2>Pricing</h2>
      <p class="note">Figures are placeholders — send me the real plans</p>
    </div>

    <div class="pricing-grid">
      <div class="tier glass-card">
        <div class="tier-name">Single site</div>
        <div class="tier-price">£—<span>/month</span></div>
        <div class="tier-rule"></div>
        <div class="tier-list">
          <div>Unlimited pre-order bookings</div>
          <div>À la carte and set menus</div>
          <div>Kitchen and door exports</div>
          <div>Your own Stripe account</div>
        </div>
        <a href="#early-access" class="btn btn-outline btn-block">{ctaLabel}</a>
      </div>

      <div class="tier tier-featured">
        <div class="glow"></div>
        <div class="tier-inner">
          <div class="tier-top">
            <div class="tier-name tier-name--dark">Group</div>
            <div class="tier-badge">MOST CHOSEN</div>
          </div>
          <div class="tier-price tier-price--dark">£—<span>/site/month</span></div>
          <div class="tier-rule tier-rule--dark"></div>
          <div class="tier-list tier-list--dark">
            <div>Everything in Single site</div>
            <div>Multi-site dashboard and roles</div>
            <div>Referral partners and cards</div>
            <div>Review requests after service</div>
          </div>
          <a href="#early-access" class="btn btn-light btn-block">{ctaLabel}</a>
        </div>
      </div>

      <div class="tier glass-card">
        <div class="tier-name">Enterprise</div>
        <div class="tier-price">Talk to us</div>
        <div class="tier-rule"></div>
        <div class="tier-list">
          <div>POS and PMS integrations</div>
          <div>Custom reporting</div>
          <div>Onboarding for every site</div>
          <div>Priority support</div>
        </div>
        <a href="#contact" class="btn btn-outline btn-block">Contact sales</a>
      </div>
    </div>
  </div>
</section>

<style>
  .pricing {
    background: var(--paper);
    padding: 0 0 96px;
  }

  .pricing-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
  }

  .pricing-head h2 {
    font-weight: 700;
    font-size: clamp(28px, 3.4vw, 46px);
    line-height: 1.04;
    letter-spacing: -0.032em;
    color: var(--ink);
  }

  .note {
    font: 400 12.5px/1 var(--font-mono);
    color: var(--muted-2);
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin-top: 36px;
  }

  .tier {
    padding: 32px 30px 34px;
  }

  .tier-featured {
    position: relative;
    padding: 0;
    border-radius: 18px;
    background: var(--accent-deep);
    overflow: hidden;
  }

  .tier-featured .glow {
    top: -120px;
    right: -80px;
    width: 320px;
    height: 320px;
    filter: blur(46px);
    background: radial-gradient(circle, rgba(var(--accent-glow), 0.7), rgba(var(--accent-glow), 0) 70%);
  }

  .tier-inner {
    position: relative;
    padding: 32px 30px 34px;
  }

  .tier-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .tier-name {
    font-size: 15px;
    font-weight: 600;
    color: var(--ink);
  }

  .tier-name--dark {
    color: var(--on-dark);
  }

  .tier-badge {
    font: 500 10.5px/1 var(--font-mono);
    color: #20342f;
    background: #c9d9d5;
    padding: 4px 8px;
    border-radius: 999px;
  }

  .tier-price {
    margin-top: 14px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 42px;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .tier-price span {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 500;
    color: var(--muted-2);
  }

  .tier-price--dark {
    color: var(--on-dark);
  }

  .tier-price--dark span {
    color: rgba(246, 245, 242, 0.55);
  }

  .tier-rule {
    height: 1px;
    background: rgba(20, 23, 26, 0.1);
    margin: 24px 0;
  }

  .tier-rule--dark {
    background: rgba(255, 255, 255, 0.14);
  }

  .tier-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 14px;
    color: var(--muted);
  }

  .tier-list--dark {
    color: rgba(246, 245, 242, 0.72);
  }

  .tier .btn {
    margin-top: 26px;
    padding: 13px;
  }

  @media (max-width: 980px) {
    .pricing-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
