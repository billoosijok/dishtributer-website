---
interface Props {
  label: string;
  tone?: 'light' | 'dark';
  radius?: string;
}

const { label, tone = 'light', radius = '0' } = Astro.props;
---

<div class:list={['placeholder', tone]} style={{ borderRadius: radius }}>
  <span class="label">{label}</span>
</div>

<style>
  .placeholder {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 100%;
    display: flex;
    align-items: flex-end;
    padding: 16px;
    box-sizing: border-box;
    background-image:
      repeating-linear-gradient(135deg, rgba(20, 23, 26, 0.06) 0, rgba(20, 23, 26, 0.06) 1px, transparent 1px, transparent 14px);
  }

  .placeholder.light {
    background-color: #dcd8cf;
  }

  .placeholder.dark {
    background-color: rgba(255, 255, 255, 0.08);
  }

  .label {
    font: 500 11.5px/1.4 'IBM Plex Mono', monospace;
    letter-spacing: 0.02em;
    padding: 6px 10px;
    border-radius: 8px;
    max-width: 80%;
  }

  .placeholder.light .label {
    color: #5c6663;
    background: rgba(255, 255, 255, 0.6);
  }

  .placeholder.dark .label {
    color: rgba(246, 245, 242, 0.75);
    background: rgba(0, 0, 0, 0.25);
  }
</style>
