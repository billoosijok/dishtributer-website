---
import ImagePlaceholder from './ImagePlaceholder.astro';

const testimonials = [
  {
    quote:
      '“We stopped losing Saturday tables to no-shows the week we switched the deposit to a full pre-order.”',
    attribution: '[ Name ] · [ Restaurant, City ]',
  },
  {
    quote: '“The kitchen sheet is the bit the chefs care about. They know the covers before they walk in.”',
    attribution: '[ Name ] · [ Restaurant, City ]',
  },
];
---

<section class="testimonials" id="reviews">
  <div class="testimonials-grid">
    <div class="testimonials-head">
      <p class="eyebrow">TESTIMONIALS</p>
      <h2>What operators <span class="accent">say</span></h2>
      <p class="sub">
        Placeholder quotes — send me three real ones and I'll drop them in with names,
        restaurants and headshots.
      </p>
    </div>

    <div class="testimonials-list">
      {
        testimonials.map((t) => (
          <div class="testimonial glass-card">
            <p class="quote">{t.quote}</p>
            <div class="attribution-row">
              <div class="avatar">
                <ImagePlaceholder label="Headshot" />
              </div>
              <div class="attribution">{t.attribution}</div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .testimonials {
    position: relative;
    z-index: 3;
    background: var(--paper);
    padding: 112px var(--gutter) 96px;
    border-radius: 76px 76px 0 0;
    margin-top: -60px;
  }

  .testimonials-grid {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: 64px;
    align-items: start;
  }

  .eyebrow {
    color: var(--muted-2);
  }

  .testimonials-head h2 {
    margin: 16px 0 0;
    font-weight: 700;
    font-size: clamp(28px, 3.4vw, 46px);
    line-height: 1.04;
    letter-spacing: -0.032em;
    color: var(--ink);
  }

  .accent {
    color: var(--accent);
  }

  .sub {
    margin: 18px 0 0;
    max-width: 400px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
  }

  .testimonials-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .testimonial {
    padding: 30px 32px;
  }

  .quote {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 22px;
    line-height: 1.4;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .attribution-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 20px;
  }

  .avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
  }

  .attribution {
    font: 400 12.5px/1 var(--font-mono);
    color: var(--muted-2);
  }

  @media (max-width: 900px) {
    .testimonials-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .testimonials {
      border-radius: 44px 44px 0 0;
    }
  }
</style>
