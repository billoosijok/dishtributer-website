---
import Nav from './Nav.astro';
import Ticker from './Ticker.astro';
import ImagePlaceholder from './ImagePlaceholder.astro';

const ctaLabel = 'Join early access';
---

<section class="hero-wrap">
  <div class="glow glow-teal"></div>
  <div class="glow glow-sand"></div>

  <Nav />

  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">EARLY ACCESS · SELECT RESTAURANTS · GENERAL LAUNCH OCTOBER 2026</p>
      <h1>The table is booked. <span class="accent">The order is in.</span></h1>
      <p class="lede">
        Send one link, let the party choose and pay, and hand the kitchen an exact prep list the
        night before. We're running with a small group of restaurants now, ahead of the October
        2026 launch.
      </p>
      <div class="cta-row">
        <a href="#early-access" class="btn btn-primary">{ctaLabel}<span>→</span></a>
        <a href="#booking-demo" class="btn btn-glass">Watch a booking go out</a>
      </div>
      <div class="fact-row">
        <div>Stripe payouts</div>
        <div>À la carte and set menus</div>
        <div>English and French</div>
      </div>
    </div>

    <div class="hero-visual">
      <div class="hero-shot">
        <ImagePlaceholder label="Guest pre-order flow, portrait screenshot (900×1400)" />
      </div>
      <div class="float-card float-card--left glass-card">
        <div class="float-eyebrow">TABLE 12 · 8 GUESTS</div>
        <div class="float-value">All courses chosen</div>
      </div>
      <div class="float-card float-card--right">
        <div class="float-eyebrow float-eyebrow--dark">PAID</div>
        <div class="float-value float-value--dark">£412.00</div>
      </div>
    </div>
  </div>

  <Ticker />
</section>

<style>
  .hero-wrap {
    position: relative;
    overflow: hidden;
    background: var(--paper);
    padding: 0 0 72px;
  }

  .glow-teal {
    top: -120px;
    right: 80px;
    width: 640px;
    height: 640px;
    background: radial-gradient(circle, rgba(var(--accent-glow), 0.5), rgba(var(--accent-glow), 0) 66%);
  }

  .glow-sand {
    top: 240px;
    left: -200px;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(var(--sand-glow), 0.55), rgba(var(--sand-glow), 0) 66%);
  }

  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 80px;
    align-items: center;
    padding-top: 84px;
  }

  .hero-copy h1 {
    margin: 22px 0 0;
    font-weight: 700;
    font-size: clamp(38px, 5vw, 68px);
    line-height: 1.02;
    letter-spacing: -0.032em;
    color: var(--ink);
  }

  .accent {
    color: var(--accent);
  }

  .lede {
    margin: 26px 0 0;
    max-width: 470px;
    font-size: 18px;
    line-height: 1.55;
    color: var(--body);
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }

  .fact-row {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    margin-top: 44px;
    padding-top: 24px;
    border-top: 1px solid rgba(20, 23, 26, 0.12);
    font-size: 13.5px;
    color: var(--muted);
  }

  .hero-visual {
    position: relative;
  }

  .hero-shot {
    border-radius: 26px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.7);
    box-shadow: 0 40px 80px -34px rgba(20, 23, 26, 0.5);
    height: 620px;
  }

  .float-card {
    position: absolute;
    padding: 16px 20px;
    border-radius: 16px;
    box-shadow: 0 16px 40px -18px rgba(20, 23, 26, 0.4);
  }

  .float-card--left {
    left: -56px;
    top: 96px;
    backdrop-filter: blur(34px) saturate(1.7);
    -webkit-backdrop-filter: blur(34px) saturate(1.7);
  }

  .float-card--right {
    right: -36px;
    bottom: 70px;
    background: rgba(46, 74, 70, 0.62);
    backdrop-filter: blur(34px) saturate(1.7);
    -webkit-backdrop-filter: blur(34px) saturate(1.7);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .float-eyebrow {
    font: 500 11px/1 var(--font-mono);
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  .float-eyebrow--dark {
    color: rgba(255, 255, 255, 0.7);
  }

  .float-value {
    font-size: 20px;
    font-weight: 600;
    color: var(--ink);
    letter-spacing: -0.02em;
    margin-top: 5px;
  }

  .float-value--dark {
    color: #fff;
  }

  @media (max-width: 980px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 48px;
      padding-top: 48px;
    }

    .hero-visual {
      order: -1;
    }

    .hero-shot {
      height: 420px;
    }

    .float-card--left,
    .float-card--right {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .cta-row {
      flex-direction: column;
      align-items: stretch;
    }

    .fact-row {
      flex-direction: column;
      gap: 10px;
    }
  }
</style>
